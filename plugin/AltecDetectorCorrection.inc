inline float detectorCorrection1k(float knob,int k,float source) noexcept {
 int lo=std::clamp(int(knob),0,9); float t=std::clamp(knob-lo,0.f,1.f);
 // Preview: measured -18 dBu only; do not extrapolate correction at higher levels.
 float weight=std::clamp(1.f-std::fabs(source+18.f)/6.f,0.f,1.f);
 return weight*(detectorDelta1k[lo][k-2]+t*(detectorDelta1k[lo+1][k-2]-detectorDelta1k[lo][k-2]));
}
